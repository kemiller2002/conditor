<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Presets.fs" />
    <Compile Include="Manifest.fs" />
    <Compile Include="ComponentDescriptors.fs" />
    <Compile Include="Registry.fs" />
    <Compile Include="Workstation/Model.fs" />
    <Compile Include="Compatibility.fs" />
    <Compile Include="SourceCache.fs" />
    <Compile Include="Requirements.fs" />
    <Compile Include="Scaffolding.fs" />
    <Compile Include="Planner.fs" />
    <Compile Include="ProcessRunner.fs" />
    <Compile Include="Mission.fs" />
    <Compile Include="LockFile.fs" />
    <Compile Include="Adoption.fs" />
    <Compile Include="Installer.fs" />
    <Compile Include="Readiness.fs" />
    <Compile Include="Status.fs" />
    <Compile Include="Doctor.fs" />
    <Compile Include="Repair.fs" />
    <Compile Include="Upgrade.fs" />
    <Compile Include="Launcher.fs" />
    <Compile Include="Execution.fs" />
    <Compile Include="Workstation/OfflineBundle.fs" />
    <Compile Include="Workstation/Engine.fs" />
    <Compile Include="Workstation/Lifecycle.fs" />
    <Compile Include="CurrentUpgrade.fs" />
    <Compile Include="CurrentUpgrade.fs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../examples/indy-init.conditor.json" LogicalName="Conditor.Presets.indy-init.json" />
    <EmbeddedResource Include="../../examples/clean-room.conditor.json" LogicalName="Conditor.Presets.clean-room.json" />
    <EmbeddedResource Include="../../examples/rehearsal-evidence-triage.conditor.json" LogicalName="Conditor.Presets.evidence-triage-rehearsal.json" />
    <EmbeddedResource Include="../../profiles/*.profile.json">
      <LogicalName>Conditor.Profiles.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../components/*.component.json">
      <LogicalName>Conditor.Components.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
