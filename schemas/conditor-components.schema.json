{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/conditor-components/v1",
  "title": "Conditor Component Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "distribution",
          "package",
          "defaultVersion",
          "qualifiedVersions",
          "descriptorSha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "distribution": {
            "enum": [
              "host-tool",
              "lifecycle-npm",
              "npm",
              "nuget"
            ]
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "defaultVersion": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "qualifiedVersions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "historicalPackages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "package",
                "versions"
              ],
              "properties": {
                "package": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "versions": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            }
          },
          "lifecycleSource": {
            "type": "string",
            "minLength": 1
          },
          "applicationBinding": {
            "enum": [
              "npm",
              "nuget"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "descriptorSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "distribution"
              ],
              "properties": {
                "distribution": {
                  "const": "host-tool"
                }
              }
            },
            "then": {
              "required": [
                "command"
              ],
              "not": {
                "required": [
                  "lifecycleSource"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "distribution"
              ],
              "properties": {
                "distribution": {
                  "const": "lifecycle-npm"
                }
              }
            },
            "then": {
              "required": [
                "lifecycleSource",
                "command"
              ]
            }
          },
          {
            "if": {
              "required": [
                "distribution"
              ],
              "properties": {
                "distribution": {
                  "const": "npm"
                }
              }
            },
            "then": {
              "required": [
                "applicationBinding"
              ],
              "properties": {
                "applicationBinding": {
                  "const": "npm"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "distribution"
              ],
              "properties": {
                "distribution": {
                  "const": "nuget"
                }
              }
            },
            "then": {
              "required": [
                "applicationBinding"
              ],
              "properties": {
                "applicationBinding": {
                  "const": "nuget"
                }
              }
            }
          }
        ]
      }
    }
  }
}
