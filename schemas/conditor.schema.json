{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/conditor/v1",
  "title": "Conditor Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "launcher": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "contractPath": {
          "type": "string",
          "minLength": 1
        },
        "permissionMode": {
          "description": "Claude Code permission mode for headless runs. Modes that wait for a person (plan, manual) are not allowed.",
          "enum": [
            "acceptEdits",
            "auto",
            "bypassPermissions",
            "dontAsk"
          ]
        }
      }
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "targetPath"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "targetPath": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "commit",
              "path"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "requirementsImport": {
      "description": "Turns the materialized planning documents into Praxis slice work items and a trace of every source requirement (conditor requirements import).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemPrefix",
        "source",
        "kickoff",
        "traceAttachment",
        "documents",
        "kickoffExpected",
        "additionalSlices",
        "assignments"
      ],
      "properties": {
        "workItemPrefix": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kickoff": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "traceAttachment": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scheme",
              "path",
              "heading",
              "expected"
            ],
            "properties": {
              "scheme": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "expected": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "kickoffExpected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prioritySlices",
            "successGates",
            "stopTheLine"
          ],
          "properties": {
            "prioritySlices": {
              "type": "integer",
              "minimum": 1
            },
            "successGates": {
              "type": "integer",
              "minimum": 1
            },
            "stopTheLine": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "additionalSlices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "after",
              "cutPolicy",
              "goal",
              "basis"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "cutPolicy": {
                "enum": [
                  "never-cut",
                  "cut-last",
                  "stretch",
                  "deferred"
                ]
              },
              "goal": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slice",
              "match"
            ],
            "properties": {
              "slice": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "match": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "acceptance": {
          "description": "Acceptance criteria that factory decisions add to a slice, at most one entry per slice.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slice",
              "criteria"
            ],
            "properties": {
              "slice": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "criteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "required": [
              "launcher",
              "contractPath"
            ]
          }
        }
      }
    }
  ]
}
