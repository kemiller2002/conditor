{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/conditor-lock/v3",
  "title": "Conditor Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "manifestSha256",
    "manifest",
    "components",
    "requirements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest": {
      "$ref": "./conditor.schema.json"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "distribution",
          "package",
          "descriptorSha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "distribution": {
            "enum": [
              "lifecycle-npm",
              "npm",
              "nuget"
            ]
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "sourceReference": {
            "type": "string",
            "minLength": 1
          },
          "descriptorSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceReference",
          "targetPath"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceReference": {
            "type": "string",
            "minLength": 1
          },
          "targetPath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviewSignals": {
      "type": "array",
      "description": "Structural review findings (e.g. Ordo SDE-STRUCT-001) that integrity gates reported without failing. Present only when there are any. Review signals, not refusals.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "code",
          "band",
          "path",
          "lineCount"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "band": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "lineCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
