{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/conditor-component/v1",
  "title": "Conditor Component Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "distribution",
    "package",
    "defaultVersion",
    "qualifiedVersions",
    "initArguments",
    "verifyArguments",
    "doctorArguments",
    "upgradeArguments"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "displayName": { "$ref": "#/$defs/nonBlankString" },
    "distribution": { "enum": ["host-tool", "lifecycle-npm", "npm", "nuget"] },
    "package": {
      "$ref": "#/$defs/nonBlankString",
      "description": "The component's current package identity. Qualified versions not listed in historicalPackages are distributed under this name."
    },
    "historicalPackages": {
      "type": "array",
      "description": "Earlier package identities. Each entry owns an explicit set of qualified versions that were published only under that name. A version may appear in at most one entry, an entry may not repeat the current package, and defaultVersion must use the current package.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "versions"],
        "properties": {
          "package": { "$ref": "#/$defs/nonBlankString" },
          "versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonBlankString" }
          }
        }
      }
    },
    "defaultVersion": { "$ref": "#/$defs/nonBlankString" },
    "qualifiedVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "lifecycleSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "registry" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "commit", "entrypoint"],
          "properties": {
            "kind": { "const": "github" },
            "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
            "entrypoint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path"],
              "properties": {
                "kind": { "enum": ["node-script", "file-artifact"] },
                "path": { "$ref": "#/$defs/nonBlankString" }
              }
            }
          }
        }
      ]
    },
    "applicationBinding": {
      "enum": ["npm", "nuget"]
    },
    "command": { "type": "string", "minLength": 1 },
    "versionArguments": {
      "$ref": "#/$defs/stringArray",
      "description": "Read-only argument vector that makes `command` report the installed component version, used by existing-repository adoption. Required and non-empty for host-tool and lifecycle-npm components."
    },
    "initArguments": { "$ref": "#/$defs/stringArray" },
    "verifyArguments": { "$ref": "#/$defs/stringArray" },
    "doctorArguments": { "$ref": "#/$defs/stringArray" },
    "upgradeArguments": { "$ref": "#/$defs/stringArray" }
  },
  "allOf": [
    {
      "if": { "required": ["distribution"], "properties": { "distribution": { "const": "host-tool" } } },
      "then": {
        "required": ["command", "versionArguments"],
        "properties": { "versionArguments": { "minItems": 1 } },
        "not": { "required": ["lifecycleSource"] }
      }
    },
    {
      "if": { "required": ["distribution"], "properties": { "distribution": { "const": "lifecycle-npm" } } },
      "then": {
        "required": ["lifecycleSource", "command", "versionArguments"],
        "properties": { "versionArguments": { "minItems": 1 } }
      }
    },
    {
      "if": { "required": ["distribution"], "properties": { "distribution": { "const": "npm" } } },
      "then": { "required": ["applicationBinding"], "properties": { "applicationBinding": { "const": "npm" } } }
    },
    {
      "if": { "required": ["distribution"], "properties": { "distribution": { "const": "nuget" } } },
      "then": { "required": ["applicationBinding"], "properties": { "applicationBinding": { "const": "nuget" } } }
    }
  ],
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S",
      "description": "A string with at least one non-whitespace character, matching the loader's refusal of empty and whitespace-only values."
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
