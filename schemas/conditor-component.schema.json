{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/conditor-component/v1",
  "title": "Conditor Component Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "distribution",
    "package",
    "defaultVersion",
    "qualifiedVersions",
    "initArguments",
    "verifyArguments",
    "doctorArguments",
    "upgradeArguments"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "distribution": { "enum": ["lifecycle-npm", "npm", "nuget"] },
    "package": {
      "type": "string",
      "minLength": 1,
      "description": "The component's current package identity. Qualified versions not listed in historicalPackages are distributed under this name."
    },
    "historicalPackages": {
      "type": "array",
      "description": "Earlier package identities. Each entry owns an explicit set of qualified versions that were published only under that name. A version may appear in at most one entry, an entry may not repeat the current package, and defaultVersion must use the current package.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "versions"],
        "properties": {
          "package": { "type": "string", "minLength": 1 },
          "versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "defaultVersion": { "type": "string", "minLength": 1 },
    "qualifiedVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "lifecycleSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "registry" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "commit", "entrypoint"],
          "properties": {
            "kind": { "const": "github" },
            "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
            "entrypoint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path"],
              "properties": {
                "kind": { "enum": ["node-script", "file-artifact"] },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "applicationBinding": {
      "enum": ["npm", "nuget"]
    },
    "command": { "type": "string", "minLength": 1 },
    "initArguments": { "$ref": "#/$defs/stringArray" },
    "verifyArguments": { "$ref": "#/$defs/stringArray" },
    "doctorArguments": { "$ref": "#/$defs/stringArray" },
    "upgradeArguments": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
