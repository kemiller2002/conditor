{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/conditor-capabilities/v1",
  "title": "Conditor Component Capability Table",
  "description": "Maps a lifecycle component's versions to optional capabilities Conditor verifies after installation. Kept separate from the component descriptor so that updating a capability threshold does not change descriptor identity recorded in target locks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "component", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "component": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minimumVersion"],
        "properties": {
          "minimumVersion": {
            "description": "First qualified component version providing the capability, or null when no qualified release provides it yet.",
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" }
            ]
          },
          "description": { "type": "string" },
          "introducedBy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "commits"],
            "properties": {
              "repository": { "type": "string" },
              "commits": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
              }
            }
          },
          "requirements": { "type": "array", "items": { "type": "string" } },
          "followUp": { "type": "string" }
        }
      }
    }
  }
}
