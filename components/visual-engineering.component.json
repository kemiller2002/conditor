{
  "schemaVersion": 1,
  "id": "visual-engineering",
  "displayName": "Visual Engineering",
  "distribution": "lifecycle-npm",
  "package": "@echelon-foundry/visual-engineering",
  "defaultVersion": "1.0.1",
  "qualifiedVersions": [
    "1.0.0",
    "1.0.1"
  ],
  "lifecycleSource": {
    "kind": "registry"
  },
  "versionArguments": [
    "--version"
  ],
  "command": "visual-engineering",
  "initArguments": [
    "init"
  ],
  "verifyArguments": [
    "verify",
    "--strict"
  ],
  "doctorArguments": [
    "doctor"
  ],
  "upgradeArguments": [
    "upgrade"
  ],
  "installationMarkers": [
    ".echelon/visual-engineering.json",
    ".echelon/visual-engineering.config.json",
    ".visual-engineering"
  ]
}
