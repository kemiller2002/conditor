{
  "schemaVersion": 1,
  "id": "tutela",
  "displayName": "Tutela Security Engineering",
  "distribution": "lifecycle-npm",
  "package": "@echelon-foundry/tutela",
  "defaultVersion": "0.1.0",
  "qualifiedVersions": [
    "0.1.0"
  ],
  "lifecycleSource": {
    "kind": "github",
    "repository": "kemiller2002/tutela",
    "commit": "94afcc91a84bd3b94a4ee639f169d0727eaac727",
    "entrypoint": {
      "kind": "node-script",
      "path": "bin/tutela.mjs"
    }
  },
  "versionArguments": [
    "--version"
  ],
  "command": "tutela",
  "initArguments": [
    "init"
  ],
  "verifyArguments": [
    "verify",
    "--strict"
  ],
  "doctorArguments": [
    "doctor"
  ],
  "upgradeArguments": [
    "upgrade"
  ]
}
