{
  "schemaVersion": 1,
  "id": "praxis",
  "displayName": "Praxis / Repository Operating System",
  "distribution": "lifecycle-npm",
  "package": "@echelon-foundry/repository-operating-system",
  "defaultVersion": "3.1.4",
  "qualifiedVersions": [
    "3.1.3",
    "3.1.4",
    "3.4.0"
  ],
  "lifecycleSource": {
