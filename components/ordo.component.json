{
  "schemaVersion": 1,
  "id": "ordo",
  "displayName": "Ordo / State-Directed Engineering",
  "distribution": "host-tool",
  "package": "ordo",
  "defaultVersion": "1.4.0",
  "qualifiedVersions": [
    "1.3.0",
    "1.4.0",
    "1.4.1",
    "1.4.2",
    "1.5.0"
  ],
  "versionArguments": [
    "--version"
  ],
  "command": "ordo",
  "initArguments": [
    "init"
  ],
  "verifyArguments": [
    "verify",
    "--strict"
  ],
  "integrityGate": {
    "report": "ordo.verify-json/v1",
    "versions": [
      "1.4.2",
      "1.5.0"
    ],
    "arguments": [
      "verify",
      "--integrity-only",
      "--json"
    ]
  },
  "doctorArguments": [
    "doctor"
  ],
  "upgradeArguments": [
    "upgrade"
  ]
}
